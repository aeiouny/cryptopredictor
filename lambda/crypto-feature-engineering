import json
import boto3
import os
import math
from datetime import datetime, timezone

s3 = boto3.client('s3')
lambda_client = boto3.client('lambda')
S3_BUCKET = os.environ.get('S3_BUCKET')
INFERENCE_FUNCTION_NAME = os.environ.get('INFERENCE_FUNCTION_NAME')
ZSCORE_THRESHOLD = float(os.environ.get('ZSCORE_THRESHOLD', '2.0'))
WINDOW_SHORT = int(os.environ.get('WINDOW_SHORT', '24'))
WINDOW_LONG = int(os.environ.get('WINDOW_LONG', '168'))


def get_recent_candles_from_s3(symbol, num_files=200):
    prefix = f"raw/{symbol}/"
    paginator = s3.get_paginator('list_objects_v2')
    pages = paginator.paginate(Bucket=S3_BUCKET, Prefix=prefix)

    all_objects = []
    for page in pages:
        for obj in page.get('Contents', []):
            if obj['Key'].endswith('.json'):
                all_objects.append(obj)

    if not all_objects:
        return []

    all_objects = sorted(all_objects, key=lambda x: x['Key'])
    recent_objects = all_objects[-num_files:]

    all_candles = []
    seen_timestamps = set()

    for obj in recent_objects:
        try:
            file_response = s3.get_object(Bucket=S3_BUCKET, Key=obj['Key'])
            file_data = json.loads(file_response['Body'].read().decode())
            for candle in file_data.get('candles', []):
                ts = candle['timestamp']
                if ts not in seen_timestamps:
                    seen_timestamps.add(ts)
                    all_candles.append(candle)
        except:
            continue

    all_candles.sort(key=lambda x: x['timestamp'])
    return all_candles


def compute_features(candles):
    if len(candles) < WINDOW_LONG + 1:
        return None

    closes = [c['close'] for c in candles]
    volumes = [c['volume'] for c in candles]
    highs = [c['high'] for c in candles]
    lows = [c['low'] for c in candles]

    mean = lambda v: sum(v) / len(v)
    std = lambda v: max(math.sqrt(sum((x - mean(v))**2 for x in v) / len(v)), 0.0001)

    log_returns = [math.log(closes[i] / closes[i-1]) if closes[i-1] > 0 else 0 for i in range(1, len(closes))]

    short_returns = log_returns[-WINDOW_SHORT:]
    long_returns = log_returns[-WINDOW_LONG:]

    return {
        'log_return': log_returns[-1],
        'volatility_short': std(short_returns),
        'volatility_long': std(long_returns),
        'volatility_ratio': std(short_returns) / std(long_returns) if std(long_returns) > 0 else 1.0,
        'volume_spike': volumes[-1] / mean(volumes[-WINDOW_LONG:]) if mean(volumes[-WINDOW_LONG:]) > 0 else 1.0,
        'ma_ratio': mean(closes[-WINDOW_SHORT:]) / mean(closes[-WINDOW_LONG:]) if mean(closes[-WINDOW_LONG:]) > 0 else 1.0,
        'momentum_short': (closes[-1] - closes[-WINDOW_SHORT]) / closes[-WINDOW_SHORT] if closes[-WINDOW_SHORT] > 0 else 0,
        'momentum_long': (closes[-1] - closes[-WINDOW_LONG]) / closes[-WINDOW_LONG] if closes[-WINDOW_LONG] > 0 else 0,
        'roc': (closes[-1] - closes[-WINDOW_SHORT]) / closes[-WINDOW_SHORT] if closes[-WINDOW_SHORT] > 0 else 0,
        'return_zscore': (log_returns[-1] - mean(long_returns)) / std(long_returns) if std(long_returns) > 0 else 0,
        'daily_range': (highs[-1] - lows[-1]) / closes[-1] if closes[-1] > 0 else 0,
        'close_position': (closes[-1] - lows[-1]) / (highs[-1] - lows[-1]) if (highs[-1] - lows[-1]) > 0 else 0.5
    }


def detect_anomaly(features):
    zscore = features['return_zscore']
    if abs(zscore) >= ZSCORE_THRESHOLD:
        return True, 1 if zscore > 0 else -1
    return False, 0


def invoke_inference(features, candle, anomaly_direction):
    lambda_client.invoke(
        FunctionName=INFERENCE_FUNCTION_NAME,
        InvocationType='Event',
        Payload=json.dumps({
            "source": "feature-engineering-lambda",
            "features": features,
            "anomaly_direction": anomaly_direction,
            "candle": candle,
            "timestamp": datetime.now(timezone.utc).isoformat()
        })
    )


def lambda_handler(event, context):
    for record in event.get('Records', []):
        message = json.loads(record['body'])
        symbol = message.get('symbol', 'BTCUSDT')

        candles = get_recent_candles_from_s3(symbol)

        if len(candles) < WINDOW_LONG + 1:
            continue

        features = compute_features(candles)
        if features is None:
            continue

        is_anomaly, direction = detect_anomaly(features)

        if is_anomaly:
            invoke_inference(features, candles[-1], direction)

    return {"statusCode": 200, "body": json.dumps({"message": "Processing complete"})}